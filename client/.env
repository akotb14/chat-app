REACT_APP_LOCALHOST_KEY="chat-app-current-user"

# Base URL of the API + Socket.IO server.
#
# Must keep the REACT_APP_ prefix: Create React App only inlines variables with
# that prefix into the browser bundle. A bare `HOST=` is reserved by
# webpack-dev-server for the network interface it binds to, so setting it to a
# URL makes `npm start` die with `getaddrinfo ENOTFOUND http://localhost:5000`.
REACT_APP_API_HOST=http://localhost:5000
